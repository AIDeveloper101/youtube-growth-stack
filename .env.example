# Copy to .env.local and fill in real values yourself.
# NEVER paste real keys into chat, commits, or issues.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Apify (Console → Integrations)
APIFY_TOKEN=your-apify-token

# Firecrawl (Dashboard → API Keys)
FIRECRAWL_API_KEY=your-firecrawl-key

# Stripe (Developers → API Keys) — Phase 4
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# LLM for creative generation — provider chain:
# Anthropic (primary) → OpenAI (optional fallback) → deterministic heuristics
ANTHROPIC_API_KEY=your-anthropic-key
# Optional: only used when ANTHROPIC_API_KEY is absent
OPENAI_API_KEY=your-openai-key
